<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.song</groupId>
    <artifactId>cust-big-demo</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>cust-center</artifactId>
  <packaging>jar</packaging>
  <name>cust-center</name>
  <description>
    MyBatis-Plus 服务：@TableName 实体、BaseMapper、Wrapper/Page 调用压力。
  </description>

  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>cn.song</groupId>
      <artifactId>cust-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      编译期真实依赖：@TableName/@TableId/@TableField、BaseMapper、
      QueryWrapper/LambdaQueryWrapper、IPage/Page 都在 mybatis-plus 的非 Spring 构件里。
      语料不需要 Spring 容器，因此用 com.baomidou:mybatis-plus 而非 boot-starter，
      避免拖入 spring-boot 依赖链（离线解析会炸）。
      该构件传递 mybatis-plus-core/annotation/extension + mybatis 3.5.16 + jsqlparser 4.9，
      本地仓库均已具备（也顺带提供 cust-center 用到的 @Param）。
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus</artifactId>
      <version>3.5.7</version>
    </dependency>
    <!--
      真实工程的数据库驱动只在运行期需要，本语料编译用不到，保持注释：
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
    </dependency>
    -->
  </dependencies>
</project>
