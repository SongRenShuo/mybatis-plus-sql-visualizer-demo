<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.song</groupId>
    <artifactId>cust-big-demo</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>cust-metadata</artifactId>
  <packaging>jar</packaging>
  <name>cust-metadata</name>
  <description>
    原生 MyBatis 服务（MBG 生成风格）：40 套三件套 + selectByExample 调用点压力，
    是 SQL Visualizer 性能复现的主战场。
  </description>

  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>cn.song</groupId>
      <artifactId>cust-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      编译期真实依赖：MBG 生成风格的 Mapper 接口全部使用 org.apache.ibatis.annotations.Param。
      本工程必须能真实编译通过（IDE 内多模块解析/复现的前提），所以这里不再注释。
      版本取本机本地仓库已有版本，保证 mvn -o（离线）可解析。
    -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <version>3.5.19</version>
    </dependency>
    <!--
      以下两项只在真实工程的运行期/代码生成期需要，本语料的编译用不到，
      保持注释，避免引入无谓的离线解析依赖：
    <dependency>
      <groupId>org.mybatis.generator</groupId>
      <artifactId>mybatis-generator-core</artifactId>
      <version>1.4.2</version>
    </dependency>
    <dependency>
      <groupId>mysql</groupId>
      <artifactId>mysql-connector-java</artifactId>
      <version>8.0.33</version>
    </dependency>
    -->
  </dependencies>
</project>
