<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.3</version>
        <relativePath/>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.song</groupId>
    <artifactId>jpa-jar-model-lib</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>jpa-jar-model-lib</name>
    <description>jpa-jar-model-demo 的 JAR 态语料：@Entity / @Embeddable 全部打包进依赖 JAR（宿主工程无实体源码）</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!--
          JPA 注解（javax.persistence）与 Spring Data JPA 的 Repository 接口。
          scope=provided：运行期由宿主工程（spring-boot-starter-data-jpa）提供，
          本 JAR 只承载「模型类」，不把 Hibernate / Spring 依赖传递进宿主的依赖树。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 纯 JAR 库，不做 spring-boot 重打包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
