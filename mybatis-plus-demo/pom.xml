<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.3</version>
        <relativePath/>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.song</groupId>
    <artifactId>mybatis-plus-demo</artifactId>
    <version>1.0.0</version>
    <name>mybatis-plus-demo</name>
    <description>MyBatis-Plus SQL 可视化插件测试 Demo</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <!-- 磐维 JDBC 驱动版本：默认 2.0.0（两代类形一致，插件侧同一套三面登记覆盖）；
             需要验 V1 时 mvn -Dpanweidb.version=1.0.0 ... -->
        <panweidb.version>2.0.0</panweidb.version>
    </properties>

    <dependencies>
        <!-- 仅静态预览夹具使用；单模块导入时从本地仓库解析普通模型 JAR。 -->
        <dependency>
            <groupId>cn.song</groupId>
            <artifactId>mp-jar-model-lib</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>

        <!--spring-boot-starter-web-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--测试框架-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--使用 lombok 简化 Java 代码-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--mysql-connector-java-->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <!--mybatis-plus-boot-starter-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- validation参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- T-Embedded G3 语料：MP @TableName + jakarta @Embedded 混合实体
             （3.0.0 为 Java 8 字节码 major 52；3.1.0 是 major 55 与 JDK8 编译冲突，勿升） -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- T-PgWeave 织入验收：PG 运行 profile（application-pg.yml，runtime 即可） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>

        <!-- T-GaussDbDialect 验收：GaussDB 运行 profile（application-gaussdb.yml，runtime 即可）。
             华为官方驱动，与插件 agent 侧 WeaveSpecs 登记的 com.huawei.gaussdb.jdbc.Driver 同一个包；
             另有 opengauss 变体 com.huawei.opengauss.jdbc.Driver，本 profile 不用。 -->
        <dependency>
            <groupId>com.huaweicloud.gaussdb</groupId>
            <artifactId>gaussdbjdbc</artifactId>
            <version>506.0.0.b058-jdk7</version>
            <scope>runtime</scope>
        </dependency>

        <!-- T-IbatisPanwei 真机验收：磐维 V1 驱动连 GaussDB 内核（application-panwei-gaussdb.yml）。
             驱动不在公共 Maven，首次使用先装本机仓库（jar 在插件仓 database-lab/vendor/drivers/）：
               mvn install:install-file \
                 -Dfile=<插件仓>/database-lab/vendor/drivers/panweidb-jdbc-2.0.0.jar \
                 -DgroupId=org.panweidb -DartifactId=panweidb-jdbc -Dversion=2.0.0 -Dpackaging=jar
             runtime 即可（Spring 按 driver-class-name 反射加载）。驱动 acceptsURL 只认
             jdbc:panweidb: / jdbc:dws:iam:，jdbc:gaussdb: 会被拒。版本由 ${panweidb.version} 控制。 -->
        <dependency>
            <groupId>org.panweidb</groupId>
            <artifactId>panweidb-jdbc</artifactId>
            <version>${panweidb.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <!--环境切换：IDEA Maven 面板勾选 profile 即切数据源，默认 mysql。
        spring-boot-starter-parent 已对 application*.yml 做 @..@ 占位符资源过滤，无需额外配置。
        与 mybatis-plus-join-demo 的 dm/mysql 同一套机制，新增环境只加 profile + application-{id}.yml。-->
    <profiles>
        <profile>
            <id>mysql</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <profiles.active>mysql</profiles.active>
            </properties>
        </profile>
        <profile>
            <id>pg</id>
            <properties>
                <profiles.active>pg</profiles.active>
            </properties>
        </profile>
        <profile>
            <id>gaussdb</id>
            <properties>
                <profiles.active>gaussdb</profiles.active>
            </properties>
        </profile>
        <profile>
            <!-- T-IbatisPanwei：磐维 V1/V2 驱动 + GaussDB 内核（同一个 xc3_test 实例）。
                 验插件对 org.panweidb.Driver 的增强捕获三面登记与 jdbc:panweidb: 的角标/方言映射。 -->
            <id>panwei-gaussdb</id>
            <properties>
                <profiles.active>panwei-gaussdb</profiles.active>
            </properties>
        </profile>
        <profile>
            <!-- T-IbatisPanwei 真机：磐维 PanWeiDB 3.4.0（测试服务器 26101，datcompatibility=A/Oracle）。
                 这才是「正常数据库」那一档；GaussDB profile 只作驱动内核无关性的旁证。 -->
            <id>panwei</id>
            <properties>
                <profiles.active>panwei</profiles.active>
            </properties>
        </profile>

        <!--
          GoldenDB 自研 JDBC 驱动（T-GoldenDbDemoCases）：MySQL 协议厂商 jar，SPI 类 com.goldendb.jdbc.Driver。
          jar 是厂商二进制、公开渠道拿不到，托管在主仓 database-lab/vendor/drivers/ 下，不进任何发行包。
          以 system scope 接入（不入传递依赖），两个 profile 互斥、按需激活：
            - goldendb-driver-vendored：默认约定路径（本仓嵌在主仓 .worktrees 下的布局）文件存在时自动激活；
            - goldendb-driver-custom：传 -Dgoldendb.jdbc.jar=<jar 绝对路径> 时激活，布局自由时用这条。
          jar 不在位时两个 profile 都不激活：构建照常通过，GoldenDB 相关用例按环境变量缺席显式 skip
          （见 src/test/java/.../goldendb/GoldenDbTestEnv 的 skip 约定），不假绿。

          注（2026-11-09 订正）：这两条原本写成 pom 里的**第二个** `<profiles>` 块，Maven 的 POM XSD
          只允许一个 `<profiles>`，聚合构建在解析期即报 `Duplicated tag: 'profiles'` 并整个 reactor
          失败（连带挡住 iBatis 模块的 Maven 侧验证）。现并入上面同一个 `<profiles>`，profile 语义不变。
        -->
        <profile>
            <id>goldendb-driver-vendored</id>
            <activation>
                <file>
                    <exists>../../../database-lab/vendor/drivers/gdb_mysql-connector-java-oracle-5.1.46.99.jar</exists>
                </file>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.goldendb</groupId>
                    <artifactId>gdb_mysql-connector-java-oracle</artifactId>
                    <version>5.1.46.99</version>
                    <scope>system</scope>
                    <systemPath>${project.basedir}/../../../database-lab/vendor/drivers/gdb_mysql-connector-java-oracle-5.1.46.99.jar</systemPath>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>goldendb-driver-custom</id>
            <activation>
                <property>
                    <name>goldendb.jdbc.jar</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.goldendb</groupId>
                    <artifactId>gdb_mysql-connector-java-oracle</artifactId>
                    <version>5.1.46.99</version>
                    <scope>system</scope>
                    <systemPath>${goldendb.jdbc.jar}</systemPath>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
