<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.3</version>
        <relativePath/>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.song</groupId>
    <artifactId>mybatis-plus-demo</artifactId>
    <version>1.0.0</version>
    <name>mybatis-plus-demo</name>
    <description>MyBatis-Plus SQL 可视化插件测试 Demo</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
    </properties>

    <dependencies>
        <!--spring-boot-starter-web-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--测试框架-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--使用 lombok 简化 Java 代码-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--mysql-connector-java-->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <!--mybatis-plus-boot-starter-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- validation参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- T-Embedded G3 语料：MP @TableName + jakarta @Embedded 混合实体
             （3.0.0 为 Java 8 字节码 major 52；3.1.0 是 major 55 与 JDK8 编译冲突，勿升） -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- T-PgWeave 织入验收：PG 运行 profile（application-pg.yml，runtime 即可） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      GoldenDB 自研 JDBC 驱动（T-GoldenDbDemoCases）：MySQL 协议厂商 jar，SPI 类 com.goldendb.jdbc.Driver。
      jar 是厂商二进制、公开渠道拿不到，托管在主仓 database-lab/vendor/drivers/ 下，不进任何发行包。
      以 system scope 接入（不入传递依赖），两个 profile 互斥、按需激活：
        - goldendb-driver-vendored：默认约定路径（本仓嵌在主仓 .worktrees 下的布局）文件存在时自动激活；
        - goldendb-driver-custom：传 -Dgoldendb.jdbc.jar=<jar 绝对路径> 时激活，布局自由时用这条。
      jar 不在位时两个 profile 都不激活：构建照常通过，GoldenDB 相关用例按环境变量缺席显式 skip
      （见 src/test/java/.../goldendb/GoldenDbTestEnv 的 skip 约定），不假绿。
    -->
    <profiles>
        <profile>
            <id>goldendb-driver-vendored</id>
            <activation>
                <file>
                    <exists>../../../database-lab/vendor/drivers/gdb_mysql-connector-java-oracle-5.1.46.99.jar</exists>
                </file>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.goldendb</groupId>
                    <artifactId>gdb_mysql-connector-java-oracle</artifactId>
                    <version>5.1.46.99</version>
                    <scope>system</scope>
                    <systemPath>${project.basedir}/../../../database-lab/vendor/drivers/gdb_mysql-connector-java-oracle-5.1.46.99.jar</systemPath>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>goldendb-driver-custom</id>
            <activation>
                <property>
                    <name>goldendb.jdbc.jar</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.goldendb</groupId>
                    <artifactId>gdb_mysql-connector-java-oracle</artifactId>
                    <version>5.1.46.99</version>
                    <scope>system</scope>
                    <systemPath>${goldendb.jdbc.jar}</systemPath>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
