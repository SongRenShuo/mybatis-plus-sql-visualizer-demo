<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      聚合 POM（仅用于以多模块形式在 IDEA 中打开整个目录）。
      注意：这里的 modules 不构成父子继承关系——
      原有应用与模型库以 spring-boot-starter-parent 作为自己的 parent，
      shardingsphere-h2-demo 为无 Boot parent 的独立普通 JAR。
      本 POM 只负责聚合与统一构建入口，不向子项目传递任何依赖/属性。
    -->
    <groupId>cn.song</groupId>
    <artifactId>mybatis-plus-sql-visualizer-demo</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>mybatis-plus-sql-visualizer-demo</name>
    <description>mybatis-plus-sql-visualizer 插件测试用例 Demo 集合（多模块聚合）</description>

    <modules>
        <module>shardingsphere-h2-demo</module>
        <module>mp-jar-model-lib</module>
        <module>mybatis-plus-demo</module>
        <module>mybatis-plus-join-demo</module>
        <module>jpa-hibernate-demo</module>
        <!-- @Embedded 嵌入列前缀（Hibernate component-path 命名）复现用例；见模块 README -->
        <module>jpa-embedded-prefix-demo</module>
        <module>mybatis-plus-kotlin-demo</module>
        <module>multi-orm-demo</module>
        <!--
          selfdev-shared-lib 必须先于 selfdev-framework-demo：后者以依赖 JAR 形态引它。
          注意 IDEA 的 Maven workspace 解析会把该依赖还原成兄弟模块的 target/classes（目录形态），
          走查「帧来源=JAR」档需先根目录 install、再把本模块在 Maven 面板里 Unload，
          详见 selfdev-shared-lib/README.md。
        -->
        <module>selfdev-shared-lib</module>
        <module>selfdev-framework-demo</module>
        <!-- 原生 MyBatis（mybatis-config.xml 单配置）语料：插件 3.25「自动注入拦截器」验收宿主 -->
        <module>native-mybatis-demo</module>
        <module>ibatis2-demo</module>
        <!--
          jpa-jar-model-lib 必须先于 jpa-jar-model-demo：后者以依赖 JAR 形态引它
          （实体/嵌入类/仓库接口都在 JAR 里，宿主无源码）。单模块构建 demo 前需先
          install 后者，详见 jpa-jar-model-lib/README.md。
        -->
        <module>jpa-jar-model-lib</module>
        <module>jpa-jar-model-demo</module>
        <!--
          shadow-entity-lib 必须先于 shadow-entity-demo：后者以依赖 JAR 形态引它
          （JAR 版实体 + DAO + 带 HQL 的方法体都在 JAR 里），而宿主模块源码里另有一份
          同包同名（同 FQN）的影子实体——复现「jar 内宿主叠加工程同 FQN 影子实体
          致实体不可解析」缺陷。单模块构建 demo 前需先 install 后者，
          详见 shadow-entity-lib/README.md。
        -->
        <module>shadow-entity-lib</module>
        <module>shadow-entity-demo</module>
        <!-- Oracle 增强捕获复现语料：MyBatis-Plus 业务 SQL 全走 PreparedStatement，见模块 README -->
        <module>oracle-demo</module>
    </modules>
</project>
