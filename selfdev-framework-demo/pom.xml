<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.3</version>
        <relativePath/>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.song</groupId>
    <artifactId>selfdev-framework-demo</artifactId>
    <version>1.0.0</version>
    <name>selfdev-framework-demo</name>
    <description>自研框架源码捕获帧过滤前缀测试 Demo（模拟不经 MyBatis 的自研数据访问引擎）</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!--spring-boot-starter-web：REST 端点-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--spring-boot-starter-jdbc：JdbcTemplate / NamedParameterJdbcTemplate（模拟自研引擎的执行层）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--mysql-connector-java：真实 JDBC 驱动，agent 增强捕获的织入目标-->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <!--
          selfdev-shared-lib：E 组用例的 JAR 态语料（业务构建器 + 平台内核）。
          走查「帧来源=JAR」档时须让它以依赖 JAR 形态上 classpath：
          仓库根 mvnd install 一次 → IDEA 里 Maven 面板对本模块 Unload Projects（或改用
          mvn spring-boot:run -pl selfdev-framework-demo 单模块启动）；
          否则 IDEA 的 workspace 解析会把它换回兄弟模块的 target/classes 目录形态，
          此时 E29/E30/E31 与 E28/E32/E33 同形（该差异本身就是可观察量）。
        -->
        <dependency>
            <groupId>com.corp</groupId>
            <artifactId>selfdev-shared-lib</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
